{
  "name": "playwright-enterprise-framework",
  "version": "1.0.0",
  "description": "Enterprise Playwright Automation Framework",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:local": "cross-env ENV_FILE=.env.local playwright test",
    "test:docker": "cross-env ENV_FILE=.env.docker playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "seed:local": "cross-env ENV_FILE=.env.local tsx scripts/seedMongo.ts",
    "seed:docker": "cross-env ENV_FILE=.env.docker tsx scripts/seedMongo.ts",
    "allure:history": "tsx scripts/copyAllureHistory.ts",
    "allure:generate": "tsx scripts/copyAllureHistory.ts && allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "mongodb": "^7.5.0",
    "winston": "^3.13.0"
  }
}
